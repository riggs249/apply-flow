# Local Compose Postgres (required by docker-compose.yml)
POSTGRES_DB=applyflow
POSTGRES_USER=applyflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=4200

DB_URL=jdbc:postgresql://localhost:5432/applyflow
DB_USERNAME=applyflow
DB_PASSWORD=change-me
JWT_SECRET=use-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
SERVER_PORT=8080
# Single origin used in verification / reset / notification email links
FRONTEND_URL=http://localhost:4200
# Optional comma-separated browser origins for CORS (defaults to FRONTEND_URL)
CORS_ORIGINS=
DDL_AUTO=update
SPRING_PROFILES_ACTIVE=dev
SEED_DEMO_DATA=true
SWAGGER_ENABLED=true
DB_POOL_SIZE=5
NOTIFICATION_LEAD_PROCESS_RATE_MS=300000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_PER_WINDOW=10
RATE_LIMIT_REGISTER_PER_WINDOW=5
RATE_LIMIT_EMAIL_PER_WINDOW=3
RATE_LIMIT_TOKEN_PER_WINDOW=20

# Resume storage: local (default) or supabase
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Required when STORAGE_TYPE=supabase
# Project URL looks like https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=
# Service role key from Supabase → Project Settings → API (keep secret; backend only)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# --- Production (Vercel frontend + Render API + Supabase) ---
# Render:
#   DB_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require  (prefer session pooler)
#   STORAGE_TYPE=supabase, SUPABASE_* as above
#   FRONTEND_URL=https://your-app.vercel.app   (one canonical origin)
#   CORS_ORIGINS=https://your-app.vercel.app   (add preview origins if needed)
#   SWAGGER_ENABLED=false
#   Do NOT set SPRING_PROFILES_ACTIVE=dev or SEED_DEMO_DATA
# Vercel:
#   Root Directory = frontend
#   API_URL=https://your-service.onrender.com/api/v1

# Email (optional). When neither Resend nor SMTP is configured, links are logged by the backend.
# Recommended on Render free: Resend HTTPS API (SMTP ports 25/465/587 are blocked).
# 1) Sign up at https://resend.com → API Keys → create a key (re_...)
# 2) Local testing: MAIL_FROM=HanapTracker <onboarding@resend.dev> (delivers to your Resend account email)
# 3) Production: verify your domain and use noreply@yourdomain.com
MAIL_PROVIDER=auto
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=HanapTracker <onboarding@resend.dev>
# Optional SMTP (works locally / paid Render; ignored when RESEND_API_KEY is set with provider=auto|resend)
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_xxxxxxxx
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
EMAIL_VERIFICATION_TOKEN_HOURS=24
